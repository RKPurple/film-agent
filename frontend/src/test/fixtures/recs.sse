data: {"type": "tool_result", "id": "c3", "iteration": 3, "name": "search_tmdb", "result": {"tmdb_id": 491584, "title": "Burning", "year": "2018", "overview": "Deliveryman Jong-su is out on a job when he runs into Hae-mi, a girl who once lived in his neighborhood. She asks if he'd mind looking after her cat while she's away on a trip to Africa. On her return, she introduces to Jong-su an enigmatic young man named Ben, who she met during her trip. One day Ben tells Jong-su about his most unusual hobby.", "genres": ["Mystery", "Drama", "Thriller"], "directors": ["Lee Chang-dong"], "cast": ["Yoo Ah-in", "Steven Yeun", "Jeon Jong-seo", "Kim Soo-kyung", "Choe Seung-ho"], "already_watched": false, "poster_path": "/kXiF80o74fE9gf3Utf9moAI7ar0.jpg"}, "blocked_duplicate": false, "duration_ms": 149}

