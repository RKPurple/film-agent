# EntertainmentAI configuration template.
#
# Copy to .env and fill in your own keys:  cp .env.example .env
# .env is gitignored; this file is safe to commit.
#
# Every script picks these up automatically via env_config.py -- no more
# `export` before each run. A real `export` in your shell still takes
# priority over these values.

# --- Secrets (required) ---

# Gemini, used via its OpenAI-compatible endpoint: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TMDB (v3 API key): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Groq -- no longer used now that agent/generation calls go through Gemini.
# Kept for a possible rollback; safe to leave blank or delete.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Tunable settings. Every value below is OPTIONAL -- if a line is missing or
# blank, env_config.py falls back to the default shown, which is also the
# value the code shipped with. Uncomment and edit to change one in a single
# place for the whole project.
# ---------------------------------------------------------------------------

# --- LLM (Gemini) ---
# generate.py uses the native GenAI SDK; agent.py and the tone-summary script
# use the OpenAI-compatible endpoint below.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GENERATION_TEMPERATURE=0.2      # RAG answer generation
# TONE_TEMPERATURE=0.3            # tone-summary generation

# --- Agent loop ---
# AGENT_MAX_ITERATIONS=6          # hard cap on tool-call rounds per query

# --- Embeddings + vector store ---
# EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
# CHROMA_COLLECTION_NAME=films
# CHUNK_KEYWORD_CAP=10            # max TMDB keywords folded into each film chunk
# CHUNK_TONE_WEIGHT=2             # times the Tone: line repeats in a chunk
# CHUNK_REVIEW_WEIGHT=3           # times the My take: line repeats (heaviest)

# --- Hybrid retrieval + reranking ---
# RETRIEVAL_N_RESULTS=10          # candidate width per retriever (vector, BM25)
# RRF_K=60                        # reciprocal-rank-fusion constant
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# RERANK_TOP_N=5                  # candidates kept after reranking
# RERANK_CONFIDENCE_THRESHOLD=0.5 # min post-sigmoid score to include a chunk

# --- Postgres ---
# DB_NAME=entertainmentai
